--2.foreign key

create table customer (customer_id int primary key,
customer_name varchar(40))

select * from customer

create table orderss(order_id int primary key,
customer_id int,foreign key (customer_id)
references customer(customer_id))

select * from orderss

insert into orderss values (1,009)

CREATE TABLE orders_cascade (
    order_id INT PRIMARY KEY,
    customer_id INT REFERENCES customers(customer_id)
        ON DELETE CASCADE)

select * from orders_cascade

CREATE TABLE orders_setnull (
    order_id INT PRIMARY KEY,
    customer_id INT REFERENCES customers(customer_id)
        ON DELETE SET NULL)

select * from orders_setnull

