 --INNER JOIN Tasks

 --1. Display all students with their enrolled course names.

 SELECT s.student_name, c.course_name
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id

--2.Find students who joined available courses only.

SELECT s.*
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id

--3.Show student ID, student name, and course name together.

SELECT s.student_id, s.student_name, c.course_name
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id

--4.Find which course Kumar joined.

SELECT s.student_name, c.course_name
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id
WHERE s.student_name = 'Kumar'

--5.Display all students who joined React.js course.

SELECT s.student_name, c.course_name
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id
WHERE c.course_name = 'React.js'

--6.Find students whose course_id matches in both tables

SELECT s.*, c.course_name
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id

--7. Display only matching records between students and courses.

SELECT *
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id

--8. Count how many students are enrolled in valid courses.

SELECT COUNT(*) AS total_students
FROM student_data s
INNER JOIN course_data c
ON s.course_id = c.course_id

--LEFT JOIN Tasks

--9. Display all students even if course details are missing.

SELECT s.student_name, c.course_name
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id

--10. Find students who did not get course allocation.

SELECT s.*
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id
WHERE s.course_id IS NULL

--11. Display students whose course_name shows NULL.

SELECT s.student_name, c.course_name
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id
WHERE c.course_name IS NULL

--12. Show all student names with their course names.

SELECT s.student_name, c.course_name
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id

--13. Find students whose course_id is not available in course_data.

SELECT s.*
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id
WHERE c.course_id IS NULL

--14. Display unmatched student records.

SELECT s.*
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id
WHERE c.course_id IS NULL;

--15. Show all records from student_data table using JOIN.

SELECT s.*, c.course_name
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id

-- RIGHT JOIN Tasks

--16. Display all courses even if no students joined.

SELECT s.student_name, c.course_name
FROM student_data s
RIGHT JOIN course_data c
ON s.course_id = c.course_id

--17. Find courses without students.

SELECT c.course_id, c.course_name
FROM student_data s
RIGHT JOIN course_data c
ON s.course_id = c.course_id
WHERE s.student_id IS NULL

--18. Display NULL student names from RIGHT JOIN result.

SELECT s.student_name, c.course_name
FROM student_data s
RIGHT JOIN course_data c
ON s.course_id = c.course_id
WHERE s.student_name IS NULL

--19. Show all available courses with student names.

SELECT c.course_name, s.student_name
FROM student_data s
RIGHT JOIN course_data c
ON s.course_id = c.course_id

--20. Find which courses currently have no enrollments.

SELECT c.course_name
FROM student_data s
RIGHT JOIN course_data c
ON s.course_id = c.course_id
WHERE s.student_id IS NULL

--21. Display unmatched course records.

SELECT c.*
FROM student_data s
RIGHT JOIN course_data c
ON s.course_id = c.course_id
WHERE s.student_id IS NULL

-- FULL JOIN Tasks

--22. Display all students and all courses together.

SELECT s.student_name, c.course_name
FROM student_data s
FULL OUTER JOIN course_data c
ON s.course_id = c.course_id

--23. Find unmatched students and unmatched courses together.

SELECT s.*, c.*
FROM student_data s
FULL OUTER JOIN course_data c
ON s.course_id = c.course_id
WHERE s.student_id IS NULL
   OR c.course_id IS NULL

--24. Perform FULL JOIN using UNION query.

SELECT s.student_id, s.student_name,
       s.course_id, c.course_name
FROM student_data s
LEFT JOIN course_data c
ON s.course_id = c.course_id

UNION

SELECT s.student_id, s.student_name,
       c.course_id, c.course_name
FROM student_data s
RIGHT JOIN course_data c
ON s.course_id = c.course_id

--25. Display complete combined data from both tables.

SELECT s.*, c.*
FROM student_data s
FULL OUTER JOIN course_data c
ON s.course_id = c.course_id

--26. Find all NULL values generated in FULL JOIN.

SELECT s.*, c.*
FROM student_data s
FULL OUTER JOIN course_data c
ON s.course_id = c.course_id
WHERE s.student_id IS NULL
   OR c.course_id IS NULL

--CROSS JOIN Tasks

--27. Display all possible combinations of institute branches and courses.

SELECT i.branch_name, c.course_name
FROM institute i
CROSS JOIN course c

--28. Show branch name with every course available.

SELECT i.branch_name, c.course_name
FROM institute i
CROSS JOIN course c

--29. Count total combinations generated using CROSS JOIN.

SELECT COUNT(*) AS total_combinations
FROM institute i
CROSS JOIN course c

--30. Display:* brand_id * branch_name * course_name using CROSS JOin

SELECT i.branch_id, i.branch_name, c.course_name
FROM institute i
CROSS JOIN course c
